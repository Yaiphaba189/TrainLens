# A 2-2-1 network with hand-set weights that solve XOR.
# Open it with:  train-lens examples/xor.tlens
#
# Each line is one command; the same commands are what Python clients send
# over TCP. There is no `input` line, so the viewer feeds the two inputs with
# sine waves. Add `input 1 0` to pin them.

layers 2 2 1
act relu sigmoid
labels xor

# h0 = relu(x + y), h1 = relu(x + y - 1)
w 0 1 1  1 1
b 0 0 -1

# xor = sigmoid(10*h0 - 20*h1 - 5)
w 1 10 -20
b 1 -5
